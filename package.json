{
  "name": "tikhaya-masterskaya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx tools/check-dist.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate-content.ts",
    "simulate": "tsx tools/simulate.ts",
    "layout": "vite --config tools/layout-editor/vite.config.ts",
    "build:release": "tsc --noEmit && vite build --mode release && tsx tools/check-dist.ts",
    "package": "npm run build:release && tsx tools/package.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
